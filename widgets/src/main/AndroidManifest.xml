<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:icon="@mipmap/pack_ic_launcher"
        android:roundIcon="@mipmap/pack_ic_launcher"
        android:label="@string/pack_app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Every widget provider arrives from the libraries; this is just the
             front door that lists them and adds them to the home screen. -->
        <activity
            android:name=".WidgetPackActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The remote library carries its own launcher entry, which is right
            for the standalone remote app and wrong here: the pack would show
            two icons, one of them a second "TV Remote". The activity stays —
            WidgetPackActivity opens it — but it loses its place in the drawer.
        -->
        <activity android:name="com.techhurts.hisense_remote.RemoteSettingsActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
