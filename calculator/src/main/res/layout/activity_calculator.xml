<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a1a">

    <!-- Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111111"
        android:padding="12dp"
        android:minHeight="110dp"
        android:gravity="bottom|end">

        <TextView
            android:id="@+id/tv_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="16sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:text="" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="52sp"
            android:includeFontPadding="false"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:text="0" />

    </LinearLayout>

    <!-- Button grid — wrapped in ScrollView so square buttons never clip on small screens -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/button_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 0: CE  C  ⌫  ÷ -->
            <LinearLayout android:id="@+id/row0"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn_ce"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="CE"  android:textColor="#FFFFFF" android:textSize="28sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#B71C1C"/>
                <Button android:id="@+id/btn_c"    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="C"   android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#4a4a4a"/>
                <Button android:id="@+id/btn_back" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="⌫"   android:textColor="#FFFFFF" android:textSize="28sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#4a4a4a"/>
                <Button android:id="@+id/btn_div"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="÷"   android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#1565C0"/>
            </LinearLayout>

            <!-- Row 1: 7  8  9  × -->
            <LinearLayout android:id="@+id/row1"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn_7"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="7" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_8"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="8" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_9"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="9" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_mul" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="×" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#1565C0"/>
            </LinearLayout>

            <!-- Row 2: 4  5  6  − -->
            <LinearLayout android:id="@+id/row2"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn_4"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="4" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_5"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="5" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_6"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="6" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_sub" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="−" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#1565C0"/>
            </LinearLayout>

            <!-- Row 3: 1  2  3  + -->
            <LinearLayout android:id="@+id/row3"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn_1"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="1" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_2"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="2" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_3"   android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="3" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="+" android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#1565C0"/>
            </LinearLayout>

            <!-- Row 4: ±  0  .  = -->
            <LinearLayout android:id="@+id/row4"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal">
                <Button android:id="@+id/btn_toggle_sign" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="±"  android:textColor="#FFFFFF" android:textSize="28sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_0"           android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="0"  android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_decimal"     android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="."  android:textColor="#FFFFFF" android:textSize="36sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#3d3d3d"/>
                <Button android:id="@+id/btn_equals"      android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:text="="  android:textColor="#FFFFFF" android:textSize="36sp" android:includeFontPadding="false" android:padding="0dp" android:stateListAnimator="@null" android:backgroundTint="#E65100"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom bar: Copy | Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_copy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="📋 Copy"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:backgroundTint="#1565C0" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="✕ Close"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:backgroundTint="#424242" />

    </LinearLayout>

</LinearLayout>
