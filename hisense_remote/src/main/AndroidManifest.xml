<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <receiver
            android:name=".HisenseRemoteWidgetProvider"
            android:label="@string/remote_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.techhurts.hisense_remote.ACTION_SEND_KEY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hisense_remote_widget_provider_info" />
        </receiver>

        <activity
            android:name=".WidgetConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Asks the launcher to pin this widget to the home screen. -->
        <activity
            android:name=".PinWidgetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
            The way back into a remote already on the home screen: a widget's
            configure activity runs once, at placement, and most launchers give
            no way back to it. This is a normal app entry that lists them.
        -->
        <activity
            android:name=".RemoteSettingsActivity"
            android:exported="true"
            android:label="TV Remote"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Drag-and-drop editor for the widget's button grid. -->
        <activity
            android:name=".RemoteLayoutActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <receiver
            android:name=".Remote1x1Provider"
            android:label="TV Remote 1×1 (1 button)"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remote_widget_1x1" />
        </receiver>

        <receiver
            android:name=".Remote2x1Provider"
            android:label="TV Remote 2×1 (3 buttons)"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remote_widget_2x1" />
        </receiver>

        <receiver
            android:name=".Remote2x2Provider"
            android:label="TV Remote 2×2 (9 buttons)"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remote_widget_2x2" />
        </receiver>

        <receiver
            android:name=".Remote3x1Provider"
            android:label="TV Remote 3×1 (4 buttons)"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remote_widget_3x1" />
        </receiver>

        <receiver
            android:name=".Remote3x3Provider"
            android:label="TV Remote 3×3 (16 buttons)"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remote_widget_3x3" />
        </receiver>

        <!-- "Send to TV" in the system share sheet -->
        <activity
            android:name=".ShareToTvActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Send to TV"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>
</manifest>
