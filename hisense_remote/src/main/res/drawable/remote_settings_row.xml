<?xml version="1.0" encoding="utf-8"?>
<!-- A list row, not a button: flatter and squarer than remote_button_bg so a
     column of them reads as a list rather than a stack of keys. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#242424" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#3D3D3D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181818" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#2C2C2C" />
        </shape>
    </item>
</selector>
