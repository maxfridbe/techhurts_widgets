<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101010"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Remote layout"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/layout_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Tap an icon, then tap a cell to place it."
        android:textColor="#AAFFFFFF"
        android:textSize="13sp"
        android:gravity="center" />

    <!-- Icon colour for every button that has none of its own -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Icon colour"
        android:textColor="#88FFFFFF"
        android:textSize="11sp"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/layout_colors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal" />

    <!-- And the button behind it -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Button colour"
        android:textColor="#88FFFFFF"
        android:textSize="11sp"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/layout_button_colors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal" />

    <!-- The widget grid -->
    <GridLayout
        android:id="@+id/layout_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:background="@drawable/remote_widget_bg"
        android:padding="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Buttons"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <GridLayout
            android:id="@+id/layout_palette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_layout_reset"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Reset" />

        <Button
            android:id="@+id/btn_layout_save"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Save layout" />
    </LinearLayout>
</LinearLayout>
