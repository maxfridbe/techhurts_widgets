<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/remote_widget_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AndroidTVRemoteControl"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not Configured"
            android:textColor="#AAAAAA"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Keypad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Row 1: Power & Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/btn_power"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:text="⏻ POWER"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_power_button_bg" />

            <TextView
                android:id="@+id/btn_input"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="INPUT"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_button_bg" />
        </LinearLayout>

        <!-- D-pad Up -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_up"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="▲"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_button_bg" />

            <View
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- D-pad Left, OK, Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/btn_left"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:text="◀"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_button_bg" />

            <TextView
                android:id="@+id/btn_ok"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="OK"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_ok_button_bg" />

            <TextView
                android:id="@+id/btn_right"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_button_bg" />
        </LinearLayout>

        <!-- D-pad Down -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_down"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="▼"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_button_bg" />

            <View
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 5: Back & Home -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:text="BACK"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_button_bg" />

            <TextView
                android:id="@+id/btn_home"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="⌂ HOME"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_button_bg" />
        </LinearLayout>

        <!-- Row 6: Vol Down, Mute, Vol Up -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_vol_down"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:text="VOL -"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_button_bg" />

            <TextView
                android:id="@+id/btn_mute"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="MUTE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_button_bg" />

            <TextView
                android:id="@+id/btn_vol_up"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="VOL +"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:background="@drawable/remote_button_bg" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
