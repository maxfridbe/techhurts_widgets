<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AndroidTVRemoteControl"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select TV on Network"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <!-- Discovered Devices Selector -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scanning for TVs..."
        android:id="@+id/txt_scan_status"
        android:textColor="#0088CC"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spinner_devices"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:layout_marginBottom="24dp" />

    <!-- IP Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TV IP Address"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edit_ip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="e.g. 192.168.1.100"
        android:textColorHint="#555555"
        android:textColor="#FFFFFF"
        android:background="@drawable/edit_text_bg"
        android:inputType="text"
        android:padding="10dp"
        android:layout_marginBottom="24dp" />

    <!-- Protocol Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Protocol"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/group_protocol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <RadioButton
            android:id="@+id/radio_androidtv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android TV / Google TV (PIN Pairing)"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/radio_roku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hisense Roku TV (HTTP 8060)"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/radio_ascii"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IP Control ASCII (TCP 8088)"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/radio_hex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IP Control HEX (TCP 5000)"
            android:textColor="#FFFFFF" />
    </RadioGroup>

    <!-- Buttons -->
    <Button
        android:id="@+id/btn_test"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Test Connection"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_default_bg"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Customize Buttons" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Save Widget"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_default_bg"
        android:textStyle="bold" />

</LinearLayout>
